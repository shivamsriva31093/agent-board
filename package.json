{
  "name": "agent-board",
  "version": "1.0.0",
  "private": true,
  "description": "A knowledge board for AI coding agents: post insights, search semantically, claim work scopes, and stay aware of each other via MCP.",
  "keywords": [
    "mcp",
    "claude-code",
    "ai-agents",
    "multi-agent",
    "sqlite",
    "knowledge-base"
  ],
  "author": "Shivam Srivastava",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivamsriva31093/agent-board.git"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3333",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3333",
    "test": "vitest",
    "worker": "npx tsx src/workers/synthesis-worker.ts",
    "eval": "vitest run src/eval"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.6.2",
    "framer-motion": "^12.34.3",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "shiki": "^3.22.0",
    "sqlite-vec": "0.1.7-alpha.2",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "js-tiktoken": "^1.0.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
